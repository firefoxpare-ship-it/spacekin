rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (request.auth.token.email == 'firefox.pare@gmail.com' ||
         request.auth.token.email == 'firefox.pare.@gmail.com' ||
         request.auth.token.email.lower() == 'firefox.pare@gmail.com' ||
         request.auth.token.email.lower() == 'firefox.pare.@gmail.com');
    }

    function isStaff() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Owner', 'Admin', 'Sr Mod']);
    }

    function isAdmin() {
      return isBootstrappedAdmin() || isStaff();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Leaderboards collection - public read, admin write
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Server config - public read, admin write
    match /server_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admins registry - readable by admins, writable by bootstrapped admin or current admins
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      // User can read their own profile, or admins can read any user profile to see list of registered players
      allow get: if isOwner(userId) || isAdmin();
      // Allow list for admins to see all registered users with their emails
      allow list: if isAdmin();
      
      // User can create their own profile when signing in, or admin can manually add a user
      allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isAdmin();
      
      // User can update their own profile (e.g. minecraftUsername, lastLoginAt), admin can update anything (e.g. role)
      allow update: if (isOwner(userId) && request.resource.data.userId == userId) || isAdmin();
      
      // Only admins can delete user records
      allow delete: if isAdmin();
    }
  }
}
